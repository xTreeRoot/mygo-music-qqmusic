{
  "id": "qqmusic",
  "name": "QQ Music",
  "version": "0.3.7",
  "minAppVersion": "0.1.20",
  "main": "dist/index.js",
  "playback": "stream",
  "permissions": {
    "network": [
      "u.y.qq.com",
      "c.y.qq.com",
      "c6.y.qq.com",
      "y.qq.com",
      "xui.ptlogin2.qq.com",
      "ssl.ptlogin2.graph.qq.com",
      "graph.qq.com",
      "api.tencentmusic.com",
      "open.weixin.qq.com",
      "lp.open.weixin.qq.com",
      "y.gtimg.cn",
      "*.qqmusic.qq.com",
      "music-file.y.qq.com",
      "qpic.y.qq.com"
    ]
  },
  "settings": [
    {
      "key": "loginMethod",
      "label": "Login method",
      "help": "Choose WeChat or QQ before signing in. Unset uses WeChat. Switching methods requests a new QR code and keeps the old account until the new login succeeds.",
      "type": "select",
      "options": [
        {
          "value": "wechat",
          "label": "WeChat"
        },
        {
          "value": "qq",
          "label": "QQ"
        }
      ]
    }
  ],
  "navigation": [
    {
      "builtin": "home"
    },
    {
      "title": "Featured Playlists",
      "page": "playlists",
      "icon": "playlist"
    },
    {
      "title": "Charts",
      "page": "charts",
      "icon": "chart"
    },
    {
      "builtin": "liked"
    },
    {
      "builtin": "savedAlbums"
    },
    {
      "builtin": "stations"
    }
  ],
  "requestHeaders": [
    {
      "hosts": [
        "y.gtimg.cn",
        "music-file.y.qq.com",
        "qpic.y.qq.com"
      ],
      "kinds": [
        "image"
      ],
      "headers": {
        "Referer": "https://y.qq.com/",
        "User-Agent": "Mozilla/5.0"
      }
    },
    {
      "hosts": [
        "*.qqmusic.qq.com"
      ],
      "kinds": [
        "audio"
      ],
      "headers": {
        "Referer": "https://y.qq.com/",
        "User-Agent": "Mozilla/5.0"
      }
    }
  ]
}
